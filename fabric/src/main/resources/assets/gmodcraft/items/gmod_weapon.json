{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "firstperson_righthand",
          "firstperson_lefthand"
        ],
        "model": {
          "type": "minecraft:empty"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "cases": [
        {
          "when": "pistol",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_pistol"
          }
        },
        {
          "when": "smg",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_smg"
          }
        },
        {
          "when": "rifle",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_rifle"
          }
        },
        {
          "when": "shotgun",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_shotgun"
          }
        },
        {
          "when": "heavy",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_heavy"
          }
        },
        {
          "when": "melee",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_melee"
          }
        },
        {
          "when": "tool",
          "model": {
            "type": "minecraft:model",
            "model": "gmodcraft:item/gmod_weapon_tool"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "gmodcraft:item/gmod_weapon_generic"
      }
    }
  }
}
